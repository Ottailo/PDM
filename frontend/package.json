{
  "name": "machivital-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "vercel-build": "tsc --project tsconfig.pilot.json && vite build --config vite.pilot.config.ts",
    "preview:pilot": "vite preview --config vite.pilot.config.ts",
    "test:public-build": "node --test tests/public-build.test.mjs",
    "test:public-e2e": "playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
